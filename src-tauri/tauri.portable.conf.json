{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "io.github.winner0988.pdfreader.portable",
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/release/build-worker.mjs"
  },
  "bundle": {
    "externalBin": ["binaries/pdf_worker"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "WebView2"
      }
    }
  }
}
