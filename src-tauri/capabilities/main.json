{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window: only the app's own document commands (MVP-06, MVP-07, MVP-09, MVP-10, MVP-12, MVP-14, MVP-15, MVP-16, REL-03, #73, B2-12, B2-04, B2-02). No core:event, dialog or fs permissions: paths must never reach the WebView. Any addition needs the needs-security-review label.",
  "windows": ["main"],
  "permissions": [
    "allow-subscribe-open-events",
    "allow-open-document-dialog",
    "allow-retry-open",
    "allow-unlock-tab",
    "allow-close-tab",
    "allow-set-active-tab",
    "allow-render-page",
    "allow-cancel",
    "allow-get-outline",
    "allow-get-page-links",
    "allow-get-page-text",
    "allow-describe-link",
    "allow-open-link",
    "allow-describe-outline-link",
    "allow-open-outline-link",
    "allow-search",
    "allow-open-default-apps-settings",
    "allow-check-for-updates",
    "allow-describe-releases-page",
    "allow-open-releases-page",
    "allow-get-recent-files",
    "allow-open-recent-file",
    "allow-remove-recent-file",
    "allow-clear-recent-files",
    "allow-get-file-recording",
    "allow-set-file-recording",
    "allow-get-settings",
    "allow-set-settings",
    "allow-clear-recent-exclusions",
    "allow-export-pages",
    "allow-apply-edit",
    "allow-undo-edit",
    "allow-redo-edit",
    "allow-save-document",
    "allow-save-document-as",
    "allow-close-window",
    "allow-privacy-export"
  ]
}
